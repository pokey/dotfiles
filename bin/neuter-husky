#!/usr/bin/env bash
set -euo pipefail

# Disables Husky git hooks by:
# 1. Replacing the husky executable with a no-op script
# 2. Unsetting the git core.hooksPath configuration
#
# This is useful when you want to temporarily disable git hooks without
# uninstalling Husky or modifying package.json.

# Detect package manager
detect_package_manager() {
  if [ -f "yarn.lock" ]; then
    echo "yarn"
  elif [ -f "pnpm-lock.yaml" ]; then
    echo "pnpm"
  elif [ -f "package-lock.json" ] || [ -f "package.json" ]; then
    echo "npm"
  else
    echo ""
  fi
}

PACKAGE_MANAGER=$(detect_package_manager)

if [ -z "$PACKAGE_MANAGER" ]; then
  echo "Warning: No package manager detected (no package.json, yarn.lock, or pnpm-lock.yaml found)"
  echo "Skipping husky neutering"
else
  echo "Detected package manager: $PACKAGE_MANAGER"

  # Find husky executable using the appropriate package manager
  HUSKY_PATH=""
  case "$PACKAGE_MANAGER" in
    npm)
      HUSKY_PATH=$(npm exec which husky 2>/dev/null) || true
      ;;
    yarn)
      HUSKY_PATH=$(yarn exec which husky 2>/dev/null) || true
      ;;
    pnpm)
      HUSKY_PATH=$(pnpm exec which husky 2>/dev/null) || true
      ;;
  esac

  if [ -z "$HUSKY_PATH" ]; then
    echo "Warning: Husky not found using $PACKAGE_MANAGER, skipping husky neutering"
  else
    echo "Neutering husky at: $HUSKY_PATH"
    printf "#!/usr/bin/env bash\necho \"Husky neutered\"\n" > "$HUSKY_PATH"
  fi
fi

# Unset core.hooksPath if it exists
echo "Unsetting core.hooksPath"
git config --unset core.hooksPath 2>/dev/null || true

echo "Husky neutering complete"
