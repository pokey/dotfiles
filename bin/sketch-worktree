#!/usr/bin/env bash
set -euo pipefail
# Creates a git worktree and then runs the sketch command in that worktree.
# This script is intended to be run from a directory that is a git repository.
# It creates a new branch in a worktree under ~/src/worktrees/<current_dir>/<branch_name>.
# The prompt is passed as the last argument to the script.

if [ $# -lt 1 ]; then
  echo "Usage: sketch-worktree [additional sketch arguments...] \"prompt\""
  exit 1
fi

# Determine which environment directory to use
if ~/pokey-home-files/bin/toggl_check_client.py; then
  echo "On the clock - using Bold client environment"
  envdir=~/envs/bold/anthropic
else
  echo "Not on the clock - using personal environment"
  envdir=~/envs/anthropic
fi

# Capture the prompt (last argument) and additional arguments (all except the last one)
prompt="${@: -1}"
additional_args=()
if [ $# -gt 1 ]; then
  additional_args=("${@:1:$#-1}")
fi

# Extract GitHub issue numbers from the prompt and fetch details
echo "Extracting GitHub issues from prompt..."
TEMP_ISSUES_FILE=$(mktemp)

# Use the extract_github_issues.py script to get issue details
extract-github-issues "$prompt" "$TEMP_ISSUES_FILE" 2>/dev/null || true

# Initialize branch_description with the original prompt
branch_description="$prompt"

# If issues were found, append them to the prompt
if [ -s "$TEMP_ISSUES_FILE" ]; then
  echo "Issues found, adding details to prompt..."
  branch_description="$prompt\n\nIssue details from GitHub:$(cat "$TEMP_ISSUES_FILE")"
else
  echo "No GitHub issues found in prompt, proceeding with original prompt"
fi

# Get current directory name for worktree subdirectory
current_dir=$(basename "$(pwd)")

# Generate branch name using LLM
echo "Generating branch name from prompt..."

# Define branch_name_prompt using a heredoc
branch_name_prompt=$(
  cat <<EOF
Please generate a concise branch name using only [a-z-] chars. 
If there are github issues included, start the branch name with eg issue-123-, otherwise don't start with issue-. 
Please output only the branch name and nothing else. No preamble or additional text.
Your output will be directly fed as the name of a branch into a git branch command.
EOF
)

branch_name=$(echo "$branch_description" | envdir "$envdir" llm -m claude-3.7-sonnet -s "$branch_name_prompt")

# Sanitize branch name further to ensure it only contains allowed chars
branch_name=$(echo "$branch_name" | tr -cd 'a-z-')

# In case branch name is empty or invalid, set a default
if [ -z "$branch_name" ]; then
  branch_name="sketch-$(date +%Y%m%d-%H%M%S)"
fi

# Create worktrees directory if it doesn't exist
worktree_root=~/src/worktrees
if [ ! -d "$worktree_root" ]; then
  mkdir -p "$worktree_root"
fi

# Create project-specific worktree directory
project_worktree_dir="$worktree_root/$current_dir"
if [ ! -d "$project_worktree_dir" ]; then
  mkdir -p "$project_worktree_dir"
fi

# Full path to this specific worktree
worktree_path="$project_worktree_dir/$branch_name"

# Check if worktree already exists
if [ -d "$worktree_path" ]; then
  echo "Worktree for branch '$branch_name' already exists at $worktree_path"
else
  echo "Creating worktree for branch '$branch_name' at $worktree_path"
  # Create the git worktree
  git worktree add -b "$branch_name" "$worktree_path"
fi

# Cleanup temporary file
rm -f "$TEMP_ISSUES_FILE"

cd "$worktree_path" || {
  echo "Failed to change to directory: $worktree_path"
  exit 1
}

# Execute the unified sketch script with the created worktree
exec "$(dirname "$0")/run-sketch.sh" -- -open "$prompt" "${additional_args[@]+"${additional_args[@]}"}"
