#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 1 ]; then
  echo "Usage: sketch-dev-in-dir <worktree-directory> [additional sketch arguments...]"
  exit 1
fi

# Get the sketch directory from the first argument
sketch_dir="$1"
shift

# Execute the unified sketch script in dev mode with -open flag
exec "$(dirname "$0")/run-sketch.sh" --dev --sketch-dir "$sketch_dir" -- -open "$@"
