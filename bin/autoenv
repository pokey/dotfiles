#!/usr/bin/env bash
set -euo pipefail
# Automatically selects the appropriate environment directory based on toggl status
# and then runs the specified command with that environment.
# Usage: autoenv command [args...]

# Check if any arguments were provided
if [ $# -lt 1 ]; then
  echo "Usage: autoenv command [args...]"
  exit 1
fi

# Check if we're recording a video
SILENT=$([ -e /tmp/is-recording-video ] && echo true || echo false)

# Determine which environment directory to use
if client_name=$(~/pokey-home-files/bin/toggl_check_client.py 2>/dev/null); then
  [ "$SILENT" != true ] && echo "On the clock - using $client_name client environment" >&2
  envdir=~/envs/"$client_name"/anthropic
else
  [ "$SILENT" != true ] && echo "Not on the clock - using personal environment" >&2
  envdir=~/envs/anthropic
fi

# Run the specified command with the appropriate environment
exec envdir "$envdir" "$@"
