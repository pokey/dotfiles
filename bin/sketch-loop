#!/usr/bin/env bash
set -euo pipefail

# Check if at least one argument is provided
if [ $# -lt 1 ]; then
  echo "Usage: sketch-loop <number_of_repetitions> [sketch_arguments...]"
  exit 1
fi

# Get the first argument as the number of repetitions
repetitions=$1
shift

# Validate that repetitions is a number
if ! [[ "$repetitions" =~ ^[0-9]+$ ]]; then
  echo "Error: First argument must be a number"
  exit 1
fi

# Determine environment once outside the loop
if "$HOME/pokey-home-files/bin/toggl_check_client.py"; then
  echo "On the clock - use Bold client environment"
  ENV_DIR="$HOME/envs/bold/anthropic"
else
  echo "Not on the clock - use personal environment"
  ENV_DIR="$HOME/envs/anthropic"
fi

# Run the sketch command the specified number of times
for ((i = 1; i <= repetitions; i++)); do
  echo "Running iteration $i of $repetitions"

  # Run sketch with the pre-determined environment
  "$(dirname "$0")/run-sketch.sh" -e "$ENV_DIR" -- -one "$@"
done
